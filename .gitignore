# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
airo-*.tar

# Deploy release tarballs (built by bin/deploy.sh) and any env files.
airo-*.tar.gz
*.env

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# phx.digest output (from `mix assets.deploy`): gzipped + content-hashed copies.
# Keep the source statics (favicon.ico, robots.txt, images/logo.svg); ignore the
# generated digests so they never get committed again.
/priv/static/**/*.gz
/priv/static/**/*-????????????????????????????????.*

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/


# Local ONNX routing models (S15) — fetched, never committed
/priv/models/

# Claude Code per-machine permission grants (the shared .claude/settings.json stays tracked).
/.claude/settings.local.json

# macOS Finder metadata.
.DS_Store

# Per-workstation dev overrides (LAN bind for the observer setup, etc.).
/config/dev.local.exs
